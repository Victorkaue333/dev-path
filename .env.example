# ============================================================
# DevPath — variáveis de ambiente
# Copie para `.env` (local) e preencha. NUNCA versione valores reais.
# Referência completa: docs/ENVIRONMENT.md
# ============================================================

# --- Aplicação ---------------------------------------------
# URL pública do site. Usada em metadata, Open Graph, sitemap e canonicals.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Liga/desliga o envio de eventos de navegação pelo navegador (docs/INTEGRATION.md, seção Analytics).
# Padrão: false. Só ative após revisar a política de privacidade (LGPD).
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# --- Fonte de conteúdo -------------------------------------
# demo     -> conteúdo demonstrativo local (src/features/*/demo-data.ts), sem banco.
# database -> leitura via Prisma/PostgreSQL (exige DATABASE_URL e migrations aplicadas).
# Se vazio: usa "database" quando DATABASE_URL estiver definida, senão "demo".
CONTENT_SOURCE=demo

# --- Banco de dados (PostgreSQL) ---------------------------
# Local (Docker Compose): os valores abaixo coincidem com docker-compose.yml.
# Produção: use a URL do provedor externo (Neon, Supabase, Railway etc.) configurada no painel da Vercel.
DATABASE_URL=postgresql://devpath:devpath@localhost:5432/devpath?schema=public

# Usados apenas pelo docker-compose.yml para subir o PostgreSQL local.
POSTGRES_USER=devpath
POSTGRES_PASSWORD=devpath
POSTGRES_DB=devpath
POSTGRES_PORT=5432

# --- Autenticação do painel administrativo -----------------
# Segredo para assinar o cookie de sessão (HS256). Mínimo 32 caracteres.
# Gerar: openssl rand -base64 32
#   ou:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Duração da sessão administrativa em horas (padrão: 8).
AUTH_SESSION_TTL_HOURS=8

# --- Seeds de desenvolvimento (NUNCA em produção) ----------
# O seed cria um administrador somente se ambas as variáveis estiverem preenchidas
# e NODE_ENV for diferente de "production".
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Popular o banco com o conteúdo demonstrativo (mesmos dados de src/features/*/demo-data.ts).
SEED_DEMO_CONTENT=true
